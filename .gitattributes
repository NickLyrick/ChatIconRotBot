# Normalize line endings: LF in the repository and in the working tree.
# Prevents editors on Windows hosts from turning the whole tree into a CRLF diff.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
